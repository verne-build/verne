---
import LegalPage from "../components/LegalPage.astro";

const sections = [["status", "Publication status"]] as const;
---

<LegalPage
  title="Terms of Service — Verne"
  description="Publication status for the Verne terms of service."
  heading="Verne Terms of Service"
  lede="Verne is not publicly distributed yet. Its terms of service will be published before public distribution."
  effectiveDate="Not yet effective"
  lastUpdated="2026-08-31"
  sections={sections}
>
  <section id="status">
    <p class="section-number">01</p>
    <h2>Publication Status</h2>
    <p>
      This page intentionally does not present the upstream project's terms as Verne's. The final
      terms will identify the Verne operator, supported services, governing terms, and contact
      details before release.
    </p>
  </section>
</LegalPage>

---
import LegalPage from "../components/LegalPage.astro";

const sections = [["status", "Publication status"]] as const;
---

<LegalPage
  title="Privacy Policy — Verne"
  description="Publication status for the Verne privacy policy."
  heading="Verne Privacy Policy"
  lede="Verne is not publicly distributed yet. The privacy policy will be published before public distribution."
  effectiveDate="Not yet effective"
  lastUpdated="2026-08-31"
  sections={sections}
>
  <section id="status">
    <p class="section-number">01</p>
    <h2>Publication Status</h2>
    <p>
      This page intentionally does not reuse the upstream T3 Code privacy policy. Verne will publish
      terms that identify its operator, data practices, subprocessors, and contact details before
      the hosted service or downloadable apps are offered publicly.
    </p>
  </section>
</LegalPage>

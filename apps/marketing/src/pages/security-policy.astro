---
import LegalPage from "../components/LegalPage.astro";

const sections = [["status", "Publication status"]] as const;
---

<LegalPage
  title="Security Policy — Verne"
  description="Publication status for the Verne security policy."
  heading="Verne Security Policy"
  lede="Verne is not publicly distributed yet. A vulnerability disclosure policy will be published before release."
  effectiveDate="Not yet effective"
  lastUpdated="2026-08-31"
  sections={sections}
>
  <section id="status">
    <p class="section-number">01</p>
    <h2>Publication Status</h2>
    <p>
      The final policy will document Verne's security contact, supported versions, disclosure
      process, and safe-harbor terms. It will not reuse contact details or infrastructure claims
      belonging to the upstream project.
    </p>
  </section>
</LegalPage>

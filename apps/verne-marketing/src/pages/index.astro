---
const appUrl = "https://app.verne.build";
const repositoryUrl = "https://github.com/verne-build/verne";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Verne is a minimal GUI for coding agents." />
    <title>Verne</title>
  </head>
  <body>
    <main>
      <h1>Verne</h1>
      <p>The independent Verne website is under construction.</p>
      <nav aria-label="Verne links">
        <a href={appUrl}>Open the app</a>
        <a href={repositoryUrl}>View the source</a>
      </nav>
    </main>
  </body>
</html>

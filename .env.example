# Verne source builds use direct manual pairing by default. Account authentication and managed
# relay discovery are intentionally unconfigured for the initial release.

# Optional hosted app origin for pairing links and hosted-channel navigation.
# VERNE_HOSTED_APP_URL=https://app.verne.build

# Optional OpenTelemetry export configuration.
# VERNE_OTLP_TRACES_URL=https://collector.example.com/v1/traces
# VERNE_OTLP_METRICS_URL=https://collector.example.com/v1/metrics
# VERNE_OTLP_SERVICE_NAME=verne-server

# Optional, public mobile trace ingest configuration.
# VERNE_MOBILE_OTLP_TRACES_URL=https://collector.example.com/v1/traces
# VERNE_MOBILE_OTLP_TRACES_DATASET=verne-mobile-traces-dev
# VERNE_MOBILE_OTLP_TRACES_TOKEN=public-ingest-token
